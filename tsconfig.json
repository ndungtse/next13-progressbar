{
  "compilerOptions": {
    "esModuleInterop": true,
    "jsx": "react",
    "target": "esnext",
    "module": "esnext",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "bundler",
    "lib": [
      "es2021",
      "DOM"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "outDir": "dist"
  },
  "files": [
    "src/index.ts"
  ]
}